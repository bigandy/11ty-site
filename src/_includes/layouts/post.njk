---
layout: layouts/base.njk
templateClass: tmpl-post
themeColor: '#3454D1'
---

<article>
	<h1 class="post-title">{{ title }}</h1>

	<div class="post-inner">
		<div class="post-content">{{ content | safe }}</div>
	</div>

	<div class="post-meta">
		{% include "components/posted-on.njk" %} {% include
		"components/taglist.njk" %}
	</div>

	<p>
		<a href="{{ '/' | url }}">← Home</a>
	</p>
</article>
